      "description": "A labeled editable control using raised surface and strong border.",
      "html": "<label class=\"ds-field\">Ev adı<input type=\"text\" placeholder=\"Örn. Çamlık Ev\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:7px;color:var(--text);font-family:var(--font-reading);font-size:15px;font-weight:700}.ds-field input{min-height:50px;padding:10px 13px;border:1px solid var(--border-strong);border-radius:var(--radius-control);background:var(--surface-raised);color:var(--text);font-family:var(--font-reading);font-size:1rem}.ds-field input::placeholder{color:var(--text-muted);opacity:1}.ds-field input:hover{border-color:var(--text-muted)}.ds-field input:focus-visible{outline:3px solid var(--focus);outline-offset:3px;}"
    },
    {
      "name": "Settings Navigation",
      "kind": "nav",
      "refersTo": "settings-navigation",
      "description": "Selected desktop section uses a quiet soft surface.",
      "html": "<nav aria-label=\"Ayarlar\"><button class=\"ds-settings-nav\" aria-current=\"page\" type=\"button\">Görünüm</button></nav>",
      "css": ".ds-settings-nav{width:100%;min-height:52px;padding:12px 14px;border:0;border-radius:10px;background:var(--surface-soft);color:var(--text);text-align:left;font-family:var(--font-reading);font-size:.9375rem;font-weight:650;cursor:pointer}.ds-settings-nav:hover{background:var(--surface-soft);color:var(--text)}.ds-settings-nav:focus-visible{outline:3px solid var(--focus);outline-offset:3px;}"
    },
    {
      "name": "Working Surface",
      "kind": "card",
      "refersTo": "working-surface",
      "description": "Flat working region with an inset tonal ledger total.",
      "html": "<section class=\"ds-surface\"><h2>Açık hesap</h2><div><span>Toplam harcama</span><strong>₺2.400,00</strong></div></section>",
      "css": ".ds-surface{padding:var(--appearance-panel-padding,1.375rem);border-radius:var(--radius-surface);background:var(--surface);color:var(--text);font-family:var(--font-reading);}.ds-surface h2{margin:0;font-size:1.4375rem;letter-spacing:-.03em}.ds-surface>div{display:grid;gap:2px;margin-top:18px;padding:16px;border-radius:13px;background:var(--ledger-surface);color:var(--ledger-text)}.ds-surface span{color:var(--ledger-muted);font-size:.875rem}.ds-surface strong{font-size:clamp(1.5625rem,3vw,2rem);font-variant-numeric:tabular-nums;line-height:1.2;letter-spacing:-.035em}"
    },
    {
      "name": "Activity Filter",
      "kind": "chip",
      "refersTo": "activity-filter",
      "description": "Selected filter keeps a raised control inside a soft segmented group.",
      "html": "<div class=\"ds-filters\" role=\"group\" aria-label=\"Hareketler\"><button aria-pressed=\"true\" type=\"button\">Tümü</button><button aria-pressed=\"false\" type=\"button\">Harcamalar</button></div>",
      "css": ".ds-filters{display:flex;gap:4px;padding:4px;border-radius:12px;background:var(--surface-soft)}.ds-filters button{min-width:76px;min-height:44px;padding:6px 12px;border:0;border-radius:9px;background:transparent;color:var(--text-muted);font-family:var(--font-reading);font-size:1rem;font-weight:650;cursor:pointer}.ds-filters button[aria-pressed=true]{background:var(--surface-raised);color:var(--text);box-shadow:var(--shadow-selection)}.ds-filters button:hover{color:var(--text);background:var(--surface-raised)}.ds-filters button:focus-visible{outline:3px solid var(--focus);outline-offset:3px;}"
    },
    {
      "name": "Member Balance Row",
      "kind": "custom",
      "description": "A stacked identity and written balance state with aligned amount.",
      "html": "<div class=\"ds-member\"><div><strong>Ece</strong><span>alacaklı</span></div><b>+₺1.100,00</b></div>",
      "css": ".ds-member{min-height:var(--appearance-row-min-height,3.875rem);padding-block:calc(var(--appearance-row-padding,1.0625rem)*.5);display:flex;align-items:center;justify-content:space-between;gap:12px;color:var(--text);font-family:var(--font-reading);}.ds-member>div{min-width:0;display:flex;flex-direction:column;gap:1px}.ds-member strong{font-size:1rem;font-weight:650;overflow-wrap:anywhere}.ds-member span{color:var(--text-muted);font-size:.875rem}.ds-member b{color:var(--positive);font-size:.9375rem;font-variant-numeric:tabular-nums;text-align:right}"
    }
  ],
  "narrative": {
    "northStar": "Sade Ortak Ev Defteri",
    "overview": "Ev Hesap should feel like a clear, shared household record: welcoming, dependable, and easy to scan while several people coordinate everyday expenses. Use familiar household language and precise money labels. Keep ledger clarity in aligned amounts, explicit alacaklı/borçlu states, and traceable expense details.\n\nThe incumbent neutral surfaces and coral default action remain the starting point. Personal appearance is an approved extension of that direction: curated palettes and independent reading preferences preserve the same semantic hierarchy and household flows. Build hierarchy with three quiet layers: room/page, working surface, and focal ledger. Avoid industrial panel motifs, rails, dense borders, decorative gradients, glass, fake testimonials, and unsupported claims.",
    "keyCharacteristics": [
      "Quiet neutral surfaces and a restrained primary accent.",
      "Aligned money values, explicit balance states, and readable Turkish copy.",
      "Rounded controls and working surfaces with spacing rather than pervasive outlines.",
      "Curated appearance choices that preserve ledger clarity."
    ],
    "rules": [
      {
        "name": "The Complete Palette Rule",
        "body": "Apply the selected preset's full semantic token map so previous theme values cannot leak into the next palette.",
        "section": "colors"
      },
      {
        "name": "The Aligned Amount Rule",
        "body": "Align comparable money values and use tabular numerals without hiding names or amounts at larger reading sizes.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Keep the page, working surface, and ledger hierarchy tonal; reserve elevation for selection and overlaid controls.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the Sade Ortak Ev Defteri direction while applying the user's complete selected palette.",
      "Do keep each name, signed amount, and written balance state readable without color.",
      "Do align comparable currency figures and use tabular numerals.",
      "Do keep appearance choices independent and identify account or device scope explicitly.",
      "Do retain keyboard focus, readable contrast, safe areas, and reduced-motion support."
    ],
    "donts": [
      "Don't turn the interface into industrial panels, rails, glass, decorative gradients, or dense outlined regions.",
      "Don't encode owing, owed, selected, or error states with color alone.",
      "Don't mix individual colors from different curated theme presets.",
      "Don't shrink touch targets to achieve compact density or hide amounts to fit larger type.",
      "Don't present illustrative household figures as verified customer evidence or claim account synchronization succeeded when it failed.\r"
    ]
  }
}
